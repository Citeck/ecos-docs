#: ../../admin/launch_setup/docker_services/eis_Keycloak.rst:366
msgid "Используемые переменные:"
msgstr "Used variables:"

#: ../../admin/launch_setup/docker_services/eis_Keycloak.rst:368
msgid ""
"**KEYCLOAK_FRONTEND_URL** -  https://example.ecos24.ru url кейклока, где "
"добавлен realm"
msgstr ""
"**KEYCLOAK_FRONTEND_URL** - https://example.ecos24.ru Keycloak URL where the"
" realm is added"

#: ../../admin/launch_setup/docker_services/eis_Keycloak.rst:369
msgid ""
"**KEYCLOAK_IMPORT** - стандартное значение /import/realm-export.json "
"успользует для того, чтоб вместе с ecos стартанул Keycloak, в котором уже "
"будет необходимы Realm"
msgstr ""
"**KEYCLOAK_IMPORT** - standard value /import/realm-export.json used so that "
"Keycloak starts together with ecos with the required Realm already "
"configured"

#: ../../admin/launch_setup/docker_services/eis_Keycloak.rst:370
msgid "**HOSTNAME** - переменная задающая имя сервиса"
msgstr "**HOSTNAME** - variable that sets the service name"

#: ../../admin/launch_setup/docker_services/eis_Keycloak.rst:371
msgid "**KEYCLOAK_LOGLEVEL** - переменная задающая loglevel Keycloak"
msgstr "**KEYCLOAK_LOGLEVEL** - variable that sets Keycloak log level"

#: ../../admin/launch_setup/docker_services/eis_Keycloak.rst:372
msgid ""
"**KEYCLOAK_USER** - admin user для входа в https://example.ecos24.ru/auth"
msgstr ""
"**KEYCLOAK_USER** - admin user for logging in at "
