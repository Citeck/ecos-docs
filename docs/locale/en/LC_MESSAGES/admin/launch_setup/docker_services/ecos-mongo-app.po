#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:36
msgid "Используемые переменные:"
msgstr "Used variables:"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:38
msgid ""
"**MONGO_INITDB_ROOT_USERNAME** - логин пользователя, который будет создан в "
"**admin db с root** привилегиями"
msgstr ""
"**MONGO_INITDB_ROOT_USERNAME** - login of the user to be created in **admin "
"db with root** privileges"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:39
msgid ""
"**MONGO_INITDB_ROOT_PASSWORD** - пароль привилегированного пользователя"
msgstr "**MONGO_INITDB_ROOT_PASSWORD** - privileged user password"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:40
msgid ""
"**MONGO_INITDB_DATABASE** - определение базы данных, используемой в скриптах"
" развертывания в ``/docker-entrypoint-initdb.d/*.js/sh. (1)``"
msgstr ""
"**MONGO_INITDB_DATABASE** - definition of the database used in deployment "
"scripts in ``/docker-entrypoint-initdb.d/*.js/sh. (1)``"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:41
msgid ""
"**ECOS_HISTORY_APP_DATASOURCE_DATABASE** - db микросервиса истории **(ecos-"
"history)**"
msgstr ""
"**ECOS_HISTORY_APP_DATASOURCE_DATABASE** - database of the history "
"microservice **(ecos-history)**"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:42
msgid ""
"**ECOS_HISTORY_APP_DATASOURCE_USERNAME** - логин для мкр истории, роль "
"dbOwner **(ecos-history)**"
msgstr ""
"**ECOS_HISTORY_APP_DATASOURCE_USERNAME** - login for the history "
"microservice, dbOwner role **(ecos-history)**"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:43
msgid ""
"**ECOS_HISTORY_APP_DATASOURCE_PASSWORD** - пароль для мкр истории **(ecos-"
"history-password)**"
msgstr ""
"**ECOS_HISTORY_APP_DATASOURCE_PASSWORD** - password for the history "
"microservice **(ecos-history-password)**"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:44
msgid ""
"**ECOS_PROCESS_APP_DATASOURCE_DATABASE** - db микросервиса ecos-process "
"**(ecos-process)**"
msgstr ""
"**ECOS_PROCESS_APP_DATASOURCE_DATABASE** - database of the ecos-process "
"microservice **(ecos-process)**"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:45
msgid ""
"**ECOS_PROCESS_APP_DATASOURCE_USERNAME **- логин для мкр ecos-process, роль "
"dbOwner **(ecos-process)**"
msgstr ""
"**ECOS_PROCESS_APP_DATASOURCE_USERNAME** - login for the ecos-process "
"microservice, dbOwner role **(ecos-process)**"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:46
msgid ""
"**ECOS_PROCESS_APP_DATASOURCE_PASSWORD** - пароль для мкр ecos-process "
"**(ecos-process-password)**"
msgstr ""
"**ECOS_PROCESS_APP_DATASOURCE_PASSWORD** - password for the ecos-process "
"microservice **(ecos-process-password)**"

#: ../../admin/launch_setup/docker_services/ecos-mongo-app.rst:48
msgid ""
"This variable allows you to specify the name of a database to be used for "
"creation scripts in /docker-entrypoint-initdb.d/.js (see Initializing a "
"fresh instance below). MongoDB is fundamentally designed for «create on "
"first use», so if you do not insert data with your JavaScript files, then no"
" database is created."
msgstr ""
"This variable allows you to specify the name of a database to be used for "
"creation scripts in /docker-entrypoint-initdb.d/.js (see Initializing a "
"fresh instance below). MongoDB is fundamentally designed for «create on "
"first use», so if you do not insert data with your JavaScript files, then no"
" database is created."

