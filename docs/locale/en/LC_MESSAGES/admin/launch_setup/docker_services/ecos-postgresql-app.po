msgstr "Docker Compose service template:"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:40
msgid "Используемые переменные:"
msgstr "Used variables:"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:42
msgid "**POSTGRES_PASSWORD** - обязательный параметр за исключением"
msgstr "**POSTGRES_PASSWORD** - mandatory parameter except for"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:43
msgid "**POSTGRES_HOST_AUTH_METHOD=trust**, пароль рутового пользователя"
msgstr "**POSTGRES_HOST_AUTH_METHOD=trust**, root user password"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:44
msgid ""
"**POSTGRES_USER** - переопределение дефолтного пользователя **postgres**"
msgstr "**POSTGRES_USER** - override of the default **postgres** user"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:45
msgid "**POSTGRES_DB** - переопределение дефолтной базы данных"
msgstr "**POSTGRES_DB** - override of the default database"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:46
msgid ""
"**POSTGRES_INITDB_ARGS** - дополнительные параметры для инициализации "
"кластера"
msgstr ""
"**POSTGRES_INITDB_ARGS** - additional parameters for cluster initialization"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:47
msgid ""
"**POSTGRES_INITDB_WALDIR** - переопределение дефолтной директории хранения "
"логов транзакций"
msgstr ""
"**POSTGRES_INITDB_WALDIR** - override of the default transaction log storage"
" directory"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:48
msgid ""
"**POSTGRES_HOST_AUTH_METHOD** - метод аутентификации host подключений для "
"всех бд, пользователей и адресов в **pg_hba.conf**. Дефолтное значение "
"**md5**"
msgstr ""
"**POSTGRES_HOST_AUTH_METHOD** - authentication method for host connections "
"for all databases, users, and addresses in **pg_hba.conf**. Default value "
"**md5**"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:49
msgid ""
"**PGDATA** - переопределение дефолтной директории хранения фалов "
"инициируемого кластера"
msgstr ""
"**PGDATA** - override of the default file storage directory of the "
"initialized cluster"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:50
msgid "**DB_NAME** - определение базы данных **ecos**"
msgstr "**DB_NAME** - definition of the **ecos** database"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:51
msgid ""
"**DB_USERNAME** - определение пользователя для базы данных "
"**ecos/flowable/ecos-history**"
msgstr ""
"**DB_USERNAME** - definition of the user for the **ecos/flowable/ecos-"
"history** database"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:52
msgid "**DB_PASSWORD** - пароль создаваемого пользователя"
msgstr "**DB_PASSWORD** - password of the user being created"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:53
msgid "**FLOWABLE_DBNAME** - определение базы данных **flowable**"
msgstr "**FLOWABLE_DBNAME** - definition of the **flowable** database"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:54
msgid ""
"**HISTORY_DBNAME** - определение базы данных для ecos-history-app "
"(устаревший параметр, базы данных мкр вынесены в отдельный инстанс)"
msgstr ""
"**HISTORY_DBNAME** - definition of the database for ecos-history-app "
"(deprecated parameter, microservice databases are moved to a separate "
"instance)"

#: ../../admin/launch_setup/docker_services/ecos-postgresql-app.rst:55
msgid ""
"**CASE_MODEL_DBNAME** - определение базы данных **ecos-case-model-app**"
msgstr ""
"**CASE_MODEL_DBNAME** - definition of the **ecos-case-model-app** database"

