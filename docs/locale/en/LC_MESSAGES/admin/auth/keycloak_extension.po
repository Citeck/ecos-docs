msgstr "``ECOS_KK_RMQ_USERNAME=admin``"

#: ../../admin/auth/keycloak_extension.rst:57
msgid "Пользователь для подключения к rabbitmq"
msgstr "User for connecting to rabbitmq"

#: ../../admin/auth/keycloak_extension.rst:58
msgid "``ECOS_KK_RMQ_PASSWORD=admin``"
msgstr "``ECOS_KK_RMQ_PASSWORD=admin``"

#: ../../admin/auth/keycloak_extension.rst:59
msgid "Пароль для подключения к rabbitmq"
msgstr "Password for connecting to rabbitmq"

#: ../../admin/auth/keycloak_extension.rst:60
msgid "``ECOS_KK_ZK_HOST=zookeeper-app``"
msgstr "``ECOS_KK_ZK_HOST=zookeeper-app``"

#: ../../admin/auth/keycloak_extension.rst:61
msgid "Хост для подключения к zookeeper"
msgstr "Host for connecting to zookeeper"

#: ../../admin/auth/keycloak_extension.rst:62
msgid "``ECOS_KK_LISTEN_PERSON_DISABLED_STATUS={{EcosIdentityApp.ecosExtensions.listenPersonDisabledStatus}}``"
msgstr "``ECOS_KK_LISTEN_PERSON_DISABLED_STATUS={{EcosIdentityApp.ecosExtensions.listenPersonDisabledStatus}}``"

#: ../../admin/auth/keycloak_extension.rst:63
msgid ""
"Флаг синхронизации отключения пользователя (см. раздел «Возможности "
