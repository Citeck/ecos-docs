msgid ""
"Чтобы данные входных элементов решения стали доступны в бизнес-процессе, "
"их необходимо передать в виде переменных."
msgstr ""
"For the input element data of the decision to become available in the "
"business process, they must be entered as variables."

#: ../../case_sample/equipment_request_p2.rst:296
#: ../../case_sample/equipment_request_p2.rst:323
msgid "Заполните форму:"
msgstr "Fill in the fields:"

#: ../../case_sample/equipment_request_p2.rst:298
msgid "**Имя** — ``Стоимость и наименование``"
msgstr "**Name** — ``Cost and Name``"

#: ../../case_sample/equipment_request_p2.rst:299
#: ../../case_sample/equipment_request_p2.rst:378
#: ../../case_sample/equipment_request_p2.rst:392
msgid "**Скрипт**:"
msgstr "**Script**:"

