#: ../../settings_kb/interface/forms/form_builder.rst:204
msgid ""
"`Документация по JSON Logic <https://help.form.io/userguide/form-building"
"/logic-and-conditions#json-logic>`_"
msgstr ""
"`JSON Logic Documentation <https://help.form.io/userguide/form-building"
"/logic-and-conditions#json-logic>`_"

