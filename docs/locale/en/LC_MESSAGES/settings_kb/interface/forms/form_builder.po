msgstr "**Property**"

#: ../../settings_kb/interface/forms/form_builder.rst:220
msgid "Изменение настроек поля (видимость, обязательность, текст подписи и др.)."
msgstr ""
"Changing field settings (visibility, mandatory status, label text, etc.)."

