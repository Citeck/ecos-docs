#: ../../settings_kb/interface/forms/form_components/components.rst:4
msgid "Подробное описание отдельных компонент"
msgstr "Detailed description of individual components"

#: ../../settings_kb/interface/forms/form_components/components.rst:6
msgid ""
"В этом разделе приведено подробное описание компонент форм платформы "
"Citeck, включая специфические настройки и возможности, дополняющие "
":ref:`общий обзор компонент <form_components_overview>`."
msgstr ""
"This section provides a detailed description of Citeck platform form "
"components, including specific settings and capabilities that complement "
"the :ref:`general components overview <form_components_overview>`."

#: ../../settings_kb/interface/forms/form_components/components.rst:8
msgid ""
":ref:`Text Field <text_field_component>` — однострочное текстовое поле "
"для ввода данных;"
msgstr ""
":ref:`Text Field <text_field_component>` — a single-line text input field;"

#: ../../settings_kb/interface/forms/form_components/components.rst:9
msgid ""
":ref:`Table form <table_form_component>` — отображение и редактирование "
"данных в табличном виде внутри формы;"
msgstr ""
":ref:`Table form <table_form_component>` — displaying and editing data in "
"a tabular layout within a form;"

#: ../../settings_kb/interface/forms/form_components/components.rst:10
msgid ""
":ref:`Async data <async_data_component>` — асинхронная загрузка данных из"
" внешних источников;"
msgstr ""
":ref:`Async data <async_data_component>` — asynchronous loading of data "
"from external sources;"

#: ../../settings_kb/interface/forms/form_components/components.rst:11
msgid ""
":ref:`Select journal <Select_journal_component>` — выбор значения из "
"записей журнала;"
msgstr ""
":ref:`Select journal <Select_journal_component>` — selecting a value from "
"journal records;"

#: ../../settings_kb/interface/forms/form_components/components.rst:12
msgid ""
":ref:`Select orgstruct <Select_orgstruct_component>` — выбор "
"пользователей и групп из оргструктуры;"
msgstr ""
":ref:`Select orgstruct <Select_orgstruct_component>` — selecting users and "
"groups from the organizational structure;"

#: ../../settings_kb/interface/forms/form_components/components.rst:13
msgid ""
":ref:`Ecos Select <ecos_select_component>` — расширенный компонент выбора"
" значений с поддержкой источников данных Citeck;"
msgstr ""
":ref:`Ecos Select <ecos_select_component>` — an advanced value selection "
"component with support for Citeck data sources;"

#: ../../settings_kb/interface/forms/form_components/components.rst:14
msgid ":ref:`File <file_component>` — загрузка файлов и управление вложениями;"
msgstr ":ref:`File <file_component>` — uploading files and managing attachments;"

#: ../../settings_kb/interface/forms/form_components/components.rst:15
msgid ""
":ref:`Columns <columns_component>` — размещение компонентов в "
"многоколоночном макете;"
msgstr ""
":ref:`Columns <columns_component>` — arranging components in a "
"multi-column layout;"

#: ../../settings_kb/interface/forms/form_components/components.rst:16
msgid ""
":ref:`Panel <panel_component>` — группировка компонентов в именованный "
"блок;"
msgstr ""
":ref:`Panel <panel_component>` — grouping components into a named block;"

#: ../../settings_kb/interface/forms/form_components/components.rst:17
msgid ""
":ref:`Horizontal line <horizontal_line_component>` — визуальный "
"разделитель блоков формы;"
msgstr ""
":ref:`Horizontal line <horizontal_line_component>` — a visual separator "
"between form sections;"

#: ../../settings_kb/interface/forms/form_components/components.rst:18
msgid ""
":ref:`Import button <import_button_component>` — кнопка для импорта "
"данных в форму;"
msgstr ""
":ref:`Import button <import_button_component>` — a button for importing "
"data into the form;"

#: ../../settings_kb/interface/forms/form_components/components.rst:19
msgid ""
":ref:`Checkbox <checkbox_component>` — флажок для выбора булевого "
"значения (да/нет)."
msgstr ""
":ref:`Checkbox <checkbox_component>` — a checkbox for selecting a boolean "
"value (yes/no)."

