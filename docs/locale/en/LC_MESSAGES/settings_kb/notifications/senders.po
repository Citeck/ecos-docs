#~ msgid "3. Пример использования command отправителя"
#~ msgstr "3. Example of Using a Command Sender"

#~ msgid ""
#~ "Для блокировки отправки сообщений были "
#~ "созданы журнал с условиями блокировок и"
#~ " command отправитель. Также создан "
#~ "обработчик команды, которая указана в "
#~ "конфигурации отправителя. Этот обработчик "
#~ "проверяет совпадают ли параметры уведомления"
#~ " с условиями в журнале блокировок, и"
#~ " если совпадают, то возвращает статус "
#~ "**BLOCKED**. Таким образом, уведомление не "
#~ "отправляется, а помечается как заблокированное"
#~ msgstr ""
#~ "For blocking message sending, a journal"
#~ " with blocking conditions and a "
#~ "command sender were created. A command"
#~ " handler was also created, which is"
#~ " specified in the sender configuration. "
#~ "This handler checks whether the "
#~ "notification parameters match the conditions"
#~ " in the blocking journal, and if "
#~ "they match, returns the **BLOCKED** "
#~ "status. Thus, the notification is not"
#~ " sent but marked as blocked"
