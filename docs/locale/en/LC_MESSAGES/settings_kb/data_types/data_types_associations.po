msgid "**Загружать список журналов из целевого типа**"
msgstr "**Load journal list from the target type**"

#: ../../settings_kb/data_types/data_types_associations.rst
msgid "загрузка списка журналов из типа данных."
msgstr "loads the list of journals from the data type."

#: ../../settings_kb/data_types/data_types_associations.rst
msgid "Возможные значения — null, true, false."
msgstr "Possible values — null, true, false."

