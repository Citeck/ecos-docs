#: ../../settings_kb/processes/ecos_bpmn/ecos_bpmn_overview.rst:4
msgid "Общее описание Citeck BPMN"
msgstr "Citeck BPMN General Overview"

#: ../../settings_kb/processes/ecos_bpmn/ecos_bpmn_overview.rst:6
msgid "Содержание"
