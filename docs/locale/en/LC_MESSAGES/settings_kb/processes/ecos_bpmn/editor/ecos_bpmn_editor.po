msgstr "**Element not connected**"

#: ../../settings_kb/processes/ecos_bpmn/editor/ecos_bpmn_editor.rst:295
#: ../../settings_kb/processes/ecos_bpmn/editor/ecos_bpmn_editor.rst:318
#: ../../settings_kb/processes/ecos_bpmn/editor/ecos_bpmn_editor.rst:387
#: ../../settings_kb/processes/ecos_bpmn/editor/ecos_bpmn_editor.rst:410
