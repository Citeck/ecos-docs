msgid "**URI**"
msgstr "**URI**"

#: ../../integration/data sources.rst:223
msgid "Строка для подключения к очереди"
msgstr "Connection string for the queue"

#: ../../integration/data sources.rst:224
msgid "**Type**"
msgstr "**Type**"

#: ../../integration/data sources.rst:225
msgid "Тип очереди"
msgstr "Queue type"

#: ../../integration/data sources.rst:226
msgid "**Credentials**"
msgstr "**Credentials**"

#: ../../integration/data sources.rst:227
msgid "Ссылка на credentials где указаны login/pass для подключения к очереди"
msgstr ""
"Reference to credentials where the login/password for connecting to the "
"queue is specified"

