#~ "Loads the specified set of attributes"
#~ " for the record whose reference is"
#~ " in the message body, and replaces"
#~ " the body with a map of "
#~ "attributes. The load is performed as "
#~ "the system user."

#~ msgid ""
#~ "**Вход:** тело — ссылка на запись "
#~ "(**EntityRef** или строка, приводимая к "
#~ "ней)."
#~ msgstr ""
#~ "**Input:** the body is a record "
