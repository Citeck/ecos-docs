msgid "``query``"
msgstr "``query``"

#: ../../general/Data_API/ECOS_Records/using_in_browser.rst:56
msgid "Любой формат, который поддерживается источником данных"
msgstr "Any format supported by the data source"

#: ../../general/Data_API/ECOS_Records/using_in_browser.rst:57
msgid "``language``"
msgstr "``language``"

#: ../../general/Data_API/ECOS_Records/using_in_browser.rst:58
