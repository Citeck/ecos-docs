#: ../../general/Data_API/ecos_data.rst
msgid "``abs ( number ) → number``"
msgstr "``abs ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Абсолютное значение"
msgstr "Absolute value"

#: ../../general/Data_API/ecos_data.rst
msgid "``abs(-17.4) → 17.4``"
msgstr "``abs(-17.4) → 17.4``"

#: ../../general/Data_API/ecos_data.rst
msgid "``ceil ( number ) → number``"
msgstr "``ceil ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Ближайшее целое, большее или равное аргументу"
msgstr "Nearest integer greater than or equal to the argument"

#: ../../general/Data_API/ecos_data.rst
msgid "``ceil(42.2) → 43``"
msgstr "``ceil(42.2) → 43``"

#: ../../general/Data_API/ecos_data.rst
msgid "``ceil(-42.8) → -42``"
msgstr "``ceil(-42.8) → -42``"

#: ../../general/Data_API/ecos_data.rst
msgid "``ceiling ( number ) → number``"
msgstr "``ceiling ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Ближайшее целое, большее или равное аргументу (равнозначно ceil)"
msgstr "Nearest integer greater than or equal to the argument (equivalent to ceil)"

#: ../../general/Data_API/ecos_data.rst
msgid "``ceiling(95.3) → 96``"
msgstr "``ceiling(95.3) → 96``"

#: ../../general/Data_API/ecos_data.rst
msgid "``div ( y number, x number ) → number``"
msgstr "``div ( y number, x number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Целочисленный результат y/x (округлённый в направлении нуля)"
msgstr "Integer result of y/x (truncated toward zero)"

#: ../../general/Data_API/ecos_data.rst
msgid "``div(9, 4) → 2``"
msgstr "``div(9, 4) → 2``"

#: ../../general/Data_API/ecos_data.rst
msgid "``exp ( number ) → number``"
msgstr "``exp ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Экспонента (e возводится в заданную степень)"
msgstr "Exponential (e raised to the given power)"

#: ../../general/Data_API/ecos_data.rst
msgid "``exp(1.0) → 2.7182818284590452``"
msgstr "``exp(1.0) → 2.7182818284590452``"

#: ../../general/Data_API/ecos_data.rst
msgid "``floor ( number ) → number``"
msgstr "``floor ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Ближайшее целое, меньшее или равное аргументу"
msgstr "Nearest integer less than or equal to the argument"

#: ../../general/Data_API/ecos_data.rst
msgid "``floor(42.8) → 42``"
msgstr "``floor(42.8) → 42``"

#: ../../general/Data_API/ecos_data.rst
msgid "``floor(-42.8) → -43``"
msgstr "``floor(-42.8) → -43``"

#: ../../general/Data_API/ecos_data.rst
msgid "``mod ( y number, x number ) → number``"
msgstr "``mod ( y number, x number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Остаток от деления y/x"
msgstr "Remainder of y/x"

#: ../../general/Data_API/ecos_data.rst
msgid "``mod(9, 4) → 1``"
msgstr "``mod(9, 4) → 1``"

#: ../../general/Data_API/ecos_data.rst
msgid "``power ( a number, b number ) → number``"
msgstr "``power ( a number, b number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "a возводится в степень b"
msgstr "a raised to the power of b"

#: ../../general/Data_API/ecos_data.rst
msgid "``power(9, 3) → 729``"
msgstr "``power(9, 3) → 729``"

#: ../../general/Data_API/ecos_data.rst
msgid "``round ( number ) → numeric``"
msgstr "``round ( number ) → numeric``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Округляет до ближайшего целого числа. Для numeric половина (.5) "
"округляется до одного по модулю."
msgstr ""
"Rounds to the nearest integer. For numeric, half (.5) rounds away from "
"zero."

#: ../../general/Data_API/ecos_data.rst
msgid "``round(42.4) → 42``"
msgstr "``round(42.4) → 42``"

#: ../../general/Data_API/ecos_data.rst
msgid "``round ( v number, s number ) → numeric``"
msgstr "``round ( v number, s number ) → numeric``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Округление v до s десятичных знаков. Половина (.5) округляется до 1 по "
"модулю."
msgstr ""
"Rounds v to s decimal places. Half (.5) rounds away from zero."

#: ../../general/Data_API/ecos_data.rst
msgid "``round(42.4382, 2) → 42.44``"
msgstr "``round(42.4382, 2) → 42.44``"

#: ../../general/Data_API/ecos_data.rst
msgid "``round(1234.56, -1) → 1230``"
msgstr "``round(1234.56, -1) → 1230``"

#: ../../general/Data_API/ecos_data.rst
msgid "``sign ( number ) → number``"
msgstr "``sign ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Знак аргумента (-1, 0 или +1)"
msgstr "Sign of the argument (-1, 0, or +1)"

#: ../../general/Data_API/ecos_data.rst
msgid "``sign(-8.4) → -1``"
msgstr "``sign(-8.4) → -1``"

#: ../../general/Data_API/ecos_data.rst
msgid "``sqrt ( number ) → number``"
msgstr "``sqrt ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Квадратный корень"
msgstr "Square root"

#: ../../general/Data_API/ecos_data.rst
msgid "``sqrt(2) → 1.4142135623730951``"
msgstr "``sqrt(2) → 1.4142135623730951``"

#: ../../general/Data_API/ecos_data.rst
msgid "``trunc ( number ) → number``"
msgstr "``trunc ( number ) → number``"

#: ../../general/Data_API/ecos_data.rst
msgid "Округление до целого (в направлении нуля)"
msgstr "Truncates to an integer (toward zero)"

#: ../../general/Data_API/ecos_data.rst
msgid "``trunc(42.8) → 42``"
msgstr "``trunc(42.8) → 42``"

#: ../../general/Data_API/ecos_data.rst
msgid "``trunc(-42.8) → -42``"
msgstr "``trunc(-42.8) → -42``"

#: ../../general/Data_API/ecos_data.rst
msgid "``btrim ( string text [, characters text] ) → text``"
msgstr "``btrim ( string text [, characters text] ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Удаляет наибольшую подстроку, содержащую только символы characters (по "
"умолчанию пробел),"
msgstr ""
"Removes the longest substring containing only the characters in "
"characters (a space by default),"

#: ../../general/Data_API/ecos_data.rst
msgid "с начала и с конца строки string."
msgstr "from the beginning and end of the string string."

#: ../../general/Data_API/ecos_data.rst
msgid "``btrim('xyxtrimyyx', 'xyz') → trim``"
msgstr "``btrim('xyxtrimyyx', 'xyz') → trim``"

#: ../../general/Data_API/ecos_data.rst
msgid "``length ( text ) → integer``"
msgstr "``length ( text ) → integer``"

#: ../../general/Data_API/ecos_data.rst
msgid "Возвращает число символов в строке."
msgstr "Returns the number of characters in the string."

#: ../../general/Data_API/ecos_data.rst
msgid "``char_length('josé') → 4``"
msgstr "``char_length('josé') → 4``"

#: ../../general/Data_API/ecos_data.rst
msgid "``initcap ( text ) → text``"
msgstr "``initcap ( text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Переводит первую букву каждого слова в строке в верхний регистр, а "
"остальные — в нижний."
msgstr ""
"Converts the first letter of each word in the string to uppercase and the "
"rest to lowercase."

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Словами считаются последовательности алфавитно-цифровых символов, "
"разделённые любыми другими символами."
msgstr ""
"Words are sequences of alphanumeric characters separated by any other "
"characters."

#: ../../general/Data_API/ecos_data.rst
msgid "``initcap('hi THOMAS') → Hi Thomas``"
msgstr "``initcap('hi THOMAS') → Hi Thomas``"

#: ../../general/Data_API/ecos_data.rst
msgid "``lpad ( string text, length integer [, fill text] ) → text``"
msgstr "``lpad ( string text, length integer [, fill text] ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Дополняет строку string слева до длины length символами fill (по "
"умолчанию пробелами)."
msgstr ""
"Pads string string on the left to length length with fill characters "
"(spaces by default)."

#: ../../general/Data_API/ecos_data.rst
msgid "Если длина строки уже больше заданной, она обрезается справа."
msgstr "If the string is already longer than the specified length, it is truncated on the right."

#: ../../general/Data_API/ecos_data.rst
msgid "``lpad('hi', 5, 'xy') → xyxhi``"
msgstr "``lpad('hi', 5, 'xy') → xyxhi``"

#: ../../general/Data_API/ecos_data.rst
msgid "``ltrim ( string text [, characters text] ) → text``"
msgstr "``ltrim ( string text [, characters text] ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Удаляет наибольшую подстроку, содержащую только символы characters (по "
"умолчанию пробелы),"
msgstr ""
"Removes the longest substring containing only the characters in "
"characters (spaces by default),"

#: ../../general/Data_API/ecos_data.rst
msgid "с начала строки string."
msgstr "from the beginning of the string string."

#: ../../general/Data_API/ecos_data.rst
msgid "``ltrim('zzzytest', 'xyz') → test``"
msgstr "``ltrim('zzzytest', 'xyz') → test``"

#: ../../general/Data_API/ecos_data.rst
msgid "``repeat ( string text, number integer ) → text``"
msgstr "``repeat ( string text, number integer ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid "Повторяет содержимое string указанное число (number) раз."
msgstr "Repeats the content of string the specified number of times."

#: ../../general/Data_API/ecos_data.rst
msgid "``repeat('Pg', 4) → PgPgPgPg``"
msgstr "``repeat('Pg', 4) → PgPgPgPg``"

#: ../../general/Data_API/ecos_data.rst
msgid "``replace ( string text, from text, to text ) → text``"
msgstr "``replace ( string text, from text, to text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid "Заменяет все вхождения в string подстроки from подстрокой to."
msgstr "Replaces all occurrences of substring from with substring to in string."

#: ../../general/Data_API/ecos_data.rst
msgid "``replace('abcdefabcdef', 'cd', 'XX') → abXXefabXXef``"
msgstr "``replace('abcdefabcdef', 'cd', 'XX') → abXXefabXXef``"

#: ../../general/Data_API/ecos_data.rst
msgid "``rpad ( string text, length integer [, fill text] ) → text``"
msgstr "``rpad ( string text, length integer [, fill text] ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Дополняет строку string справа до длины length символами fill (по "
"умолчанию пробелами). Если длина строки уже больше заданной, она "
"обрезается."
msgstr ""
"Pads string string on the right to length length with fill characters "
"(spaces by default). If the string is already longer than the specified "
"length, it is truncated."

#: ../../general/Data_API/ecos_data.rst
msgid "``rpad('hi', 5, 'xy') → hixyx``"
msgstr "``rpad('hi', 5, 'xy') → hixyx``"

#: ../../general/Data_API/ecos_data.rst
msgid "``rtrim ( string text [, characters text] ) → text``"
msgstr "``rtrim ( string text [, characters text] ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Удаляет наибольшую подстроку, содержащую только символы characters (по "
"умолчанию пробелы), с конца строки string."
msgstr ""
"Removes the longest substring containing only the characters in "
"characters (spaces by default) from the end of the string string."

#: ../../general/Data_API/ecos_data.rst
msgid "``rtrim('testxxzx', 'xyz') → test``"
msgstr "``rtrim('testxxzx', 'xyz') → test``"

#: ../../general/Data_API/ecos_data.rst
msgid "``strpos ( string text, substring text ) → integer``"
msgstr "``strpos ( string text, substring text ) → integer``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Возвращает начальную позицию первого вхождения substring в строке string "
"либо 0, если такого вхождения нет."
msgstr ""
"Returns the starting position of the first occurrence of substring in "
"string, or 0 if no such occurrence exists."

#: ../../general/Data_API/ecos_data.rst
msgid "``upper ( text ) → text``"
msgstr "``upper ( text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Переводит символы строки в верхний регистр, в соответствии с правилами "
"локали базы данных."
msgstr ""
"Converts the characters of the string to uppercase, according to the "
"database locale rules."

#: ../../general/Data_API/ecos_data.rst
msgid "``upper('tom') → TOM``"
msgstr "``upper('tom') → TOM``"

#: ../../general/Data_API/ecos_data.rst
msgid "``lower ( text ) → text``"
msgstr "``lower ( text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Переводит символы строки в нижний регистр в соответствии с правилами "
"локали базы данных."
msgstr ""
"Converts the characters of the string to lowercase according to the "
"database locale rules."

#: ../../general/Data_API/ecos_data.rst
msgid "``lower('TOM') → tom``"
msgstr "``lower('TOM') → tom``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char ( timestamp, text ) → text``"
msgstr "``to_char ( timestamp, text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char ( timestamp with time zone, text ) → text``"
msgstr "``to_char ( timestamp with time zone, text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid "Преобразует время в строку согласно заданному формату."
msgstr "Converts a timestamp to a string according to the given format."

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char(timestamp '2002-04-20 17:31:12.66', 'HH12:MI:SS') → 05:31:12``"
msgstr "``to_char(timestamp '2002-04-20 17:31:12.66', 'HH12:MI:SS') → 05:31:12``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char ( interval, text ) → text``"
msgstr "``to_char ( interval, text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid "Преобразует интервал в строку согласно заданному формату."
msgstr "Converts an interval to a string according to the given format."

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char(interval '15h 2m 12s', 'HH24:MI:SS') → 15:02:12``"
msgstr "``to_char(interval '15h 2m 12s', 'HH24:MI:SS') → 15:02:12``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char ( numeric_type, text ) → text``"
msgstr "``to_char ( numeric_type, text ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Преобразует число в строку согласно заданному формату; поддерживаются "
"типы integer, bigint, numeric, real, double precision."
msgstr ""
"Converts a number to a string according to the given format; supported "
"types are integer, bigint, numeric, real, double precision."

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char(125, '999') → 125``"
msgstr "``to_char(125, '999') → 125``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char(125.8::real, '999D9') → 125.8``"
msgstr "``to_char(125.8::real, '999D9') → 125.8``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_char(-125.8, '999D99S') → 125.80-``"
msgstr "``to_char(-125.8, '999D99S') → 125.80-``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_date ( text, text ) → date``"
msgstr "``to_date ( text, text ) → date``"

#: ../../general/Data_API/ecos_data.rst
msgid "Преобразует строку в дату согласно заданному формату."
msgstr "Converts a string to a date according to the given format."

#: ../../general/Data_API/ecos_data.rst
msgid "``to_date('05 Dec 2000', 'DD Mon YYYY') → 2000-12-05``"
msgstr "``to_date('05 Dec 2000', 'DD Mon YYYY') → 2000-12-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_number ( text, text ) → numeric``"
msgstr "``to_number ( text, text ) → numeric``"

#: ../../general/Data_API/ecos_data.rst
msgid "Преобразует строку в число согласно заданному формату."
msgstr "Converts a string to a number according to the given format."

#: ../../general/Data_API/ecos_data.rst
msgid "``to_number('12,454.8-', '99G999D9S') → -12454.8``"
msgstr "``to_number('12,454.8-', '99G999D9S') → -12454.8``"

#: ../../general/Data_API/ecos_data.rst
msgid "``to_timestamp ( text, text ) → timestamp with time zone``"
msgstr "``to_timestamp ( text, text ) → timestamp with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "Преобразует строку в значение времени согласно заданному формату."
msgstr "Converts a string to a timestamp according to the given format."

#: ../../general/Data_API/ecos_data.rst
msgid "``to_timestamp('05 Dec 2000', 'DD Mon YYYY') → 2000-12-05 00:00:00-05``"
msgstr "``to_timestamp('05 Dec 2000', 'DD Mon YYYY') → 2000-12-05 00:00:00-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``age ( timestamp, timestamp ) → interval``"
msgstr "``age ( timestamp, timestamp ) → interval``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Вычитает аргументы и выдаёт «символический» результат с годами и "
"месяцами, а не просто днями"
msgstr ""
"Subtracts the arguments and returns a \"symbolic\" result with years and "
"months rather than just days"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``age(timestamp '2001-04-10', timestamp '1957-06-13') → 43 years 9 mons "
"27 days (43 года 9 месяцев 27 дней)``"
msgstr ""
"``age(timestamp '2001-04-10', timestamp '1957-06-13') → 43 years 9 mons "
"27 days``"

#: ../../general/Data_API/ecos_data.rst
msgid "``age ( timestamp ) → interval``"
msgstr "``age ( timestamp ) → interval``"

#: ../../general/Data_API/ecos_data.rst
msgid "Вычитает аргумент из current_date (полночь текущего дня)"
msgstr "Subtracts the argument from current_date (midnight of the current day)"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``age(timestamp '1957-06-13') → 62 years 6 mons 10 days (62 года 6 "
"месяцев 10 дней)``"
msgstr ""
"``age(timestamp '1957-06-13') → 62 years 6 mons 10 days``"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_date → date``"
msgstr "``current_date → date``"

#: ../../general/Data_API/ecos_data.rst
msgid "Текущая дата"
msgstr "Current date"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_date → 2023-12-23``"
msgstr "``current_date → 2023-12-23``"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_time → time with time zone``"
msgstr "``current_time → time with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "Текущее время суток"
msgstr "Current time of day"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_time → 14:39:53.662522-05``"
msgstr "``current_time → 14:39:53.662522-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_time ( integer ) → time with time zone``"
msgstr "``current_time ( integer ) → time with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "Текущее время суток (с ограниченной точностью)"
msgstr "Current time of day (with limited precision)"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_time(2) → 14:39:53.66-05``"
msgstr "``current_time(2) → 14:39:53.66-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_timestamp → timestamp with time zone``"
msgstr "``current_timestamp → timestamp with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "Текущая дата и время (на момент начала транзакции)"
msgstr "Current date and time (at the start of the transaction)"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_timestamp → 2019-12-23 14:39:53.662522-05``"
msgstr "``current_timestamp → 2019-12-23 14:39:53.662522-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_timestamp ( integer ) → timestamp with time zone``"
msgstr "``current_timestamp ( integer ) → timestamp with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Текущие дата и время (на момент начала транзакции; с ограниченной "
"точностью)"
msgstr ""
"Current date and time (at the start of the transaction; with limited "
"precision)"

#: ../../general/Data_API/ecos_data.rst
msgid "``current_timestamp(0) → 2019-12-23 14:39:53-05``"
msgstr "``current_timestamp(0) → 2019-12-23 14:39:53-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``clock_timestamp ( ) → timestamp with time zone``"
msgstr "``clock_timestamp ( ) → timestamp with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "Текущая дата и время (меняется в процессе выполнения операторов)"
msgstr "Current date and time (changes during statement execution)"

#: ../../general/Data_API/ecos_data.rst
msgid "``clock_timestamp() → 2019-12-23 14:39:53.662522-05``"
msgstr "``clock_timestamp() → 2019-12-23 14:39:53.662522-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``date_bin ( interval, timestamp, timestamp ) → timestamp``"
msgstr "``date_bin ( interval, timestamp, timestamp ) → timestamp``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Подгоняет заданное значение под интервал, отсчитывая от указанного "
"начального момента"
msgstr ""
"Bins the given value into the specified interval, counting from the "
"indicated origin"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``date_bin('15 minutes', timestamp '2001-02-16 20:38:40', timestamp "
"'2001-02-16 20:05:00') → 2001-02-16 20:35:00``"
msgstr ""
"``date_bin('15 minutes', timestamp '2001-02-16 20:38:40', timestamp "
"'2001-02-16 20:05:00') → 2001-02-16 20:35:00``"

#: ../../general/Data_API/ecos_data.rst
msgid "``date_part ( text, timestamp ) → double precision``"
msgstr "``date_part ( text, timestamp ) → double precision``"

#: ../../general/Data_API/ecos_data.rst
msgid "Возвращает поле даты/времени (равнозначно extract)"
msgstr "Returns a date/time field (equivalent to extract)"

#: ../../general/Data_API/ecos_data.rst
msgid "``date_part('hour', timestamp '2001-02-16 20:38:40') → 20``"
msgstr "``date_part('hour', timestamp '2001-02-16 20:38:40') → 20``"

#: ../../general/Data_API/ecos_data.rst
msgid "``date_trunc ( text, timestamp ) → timestamp``"
msgstr "``date_trunc ( text, timestamp ) → timestamp``"

#: ../../general/Data_API/ecos_data.rst
msgid "Отсекает компоненты даты до заданной точности"
msgstr "Truncates date components to the specified precision"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``date_trunc('hour', timestamp '2001-02-16 20:38:40') → 2001-02-16 "
"20:00:00``"
msgstr ""
"``date_trunc('hour', timestamp '2001-02-16 20:38:40') → 2001-02-16 "
"20:00:00``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``date_trunc ( text, timestamp with time zone, text ) → timestamp with "
"time zone``"
msgstr ""
"``date_trunc ( text, timestamp with time zone, text ) → timestamp with "
"time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "Отсекает компоненты даты до заданной точности в указанном часовом поясе"
msgstr "Truncates date components to the specified precision in the given time zone"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``date_trunc('day', timestamptz '2001-02-16 20:38:40+00', "
"'Australia/Sydney') → 2001-02-16 13:00:00+00``"
msgstr ""
"``date_trunc('day', timestamptz '2001-02-16 20:38:40+00', "
"'Australia/Sydney') → 2001-02-16 13:00:00+00``"

#: ../../general/Data_API/ecos_data.rst
msgid "``date_trunc ( text, interval ) → interval``"
msgstr "``date_trunc ( text, interval ) → interval``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``date_trunc('hour', interval '2 days 3 hours 40 minutes') → 2 days "
"03:00:00``"
msgstr ""
"``date_trunc('hour', interval '2 days 3 hours 40 minutes') → 2 days "
"03:00:00``"

#: ../../general/Data_API/ecos_data.rst
msgid "``isfinite ( date ) → boolean``"
msgstr "``isfinite ( date ) → boolean``"

#: ../../general/Data_API/ecos_data.rst
msgid "Проверяет конечность даты (её отличие от +/-бесконечности)"
msgstr "Tests for finite date (not +/-infinity)"

#: ../../general/Data_API/ecos_data.rst
msgid "``isfinite(date '2001-02-16') → true``"
msgstr "``isfinite(date '2001-02-16') → true``"

#: ../../general/Data_API/ecos_data.rst
msgid "``isfinite ( timestamp ) → boolean``"
msgstr "``isfinite ( timestamp ) → boolean``"

#: ../../general/Data_API/ecos_data.rst
msgid "Проверяет конечность времени (его отличие от +/-бесконечности)"
msgstr "Tests for finite timestamp (not +/-infinity)"

#: ../../general/Data_API/ecos_data.rst
msgid "``isfinite(timestamp 'infinity') → false``"
msgstr "``isfinite(timestamp 'infinity') → false``"

#: ../../general/Data_API/ecos_data.rst
msgid "``isfinite ( interval ) → boolean``"
msgstr "``isfinite ( interval ) → boolean``"

#: ../../general/Data_API/ecos_data.rst
msgid "Проверяет конечность интервала (в настоящее время все интервалы конечны)"
msgstr "Tests for finite interval (currently all intervals are finite)"

#: ../../general/Data_API/ecos_data.rst
msgid "``isfinite(interval '4 hours') → true``"
msgstr "``isfinite(interval '4 hours') → true``"

#: ../../general/Data_API/ecos_data.rst
msgid "``justify_days ( interval ) → interval``"
msgstr "``justify_days ( interval ) → interval``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Преобразует интервал так, что каждый 30-дневный период считается одним "
"месяцем"
msgstr ""
"Adjusts the interval so that each 30-day period is counted as one month"

#: ../../general/Data_API/ecos_data.rst
msgid "``justify_days(interval '35 days') → 1 mon 5 days (1 месяц 5 дней)``"
msgstr "``justify_days(interval '35 days') → 1 mon 5 days``"

#: ../../general/Data_API/ecos_data.rst
msgid "``justify_hours ( interval ) → interval``"
msgstr "``justify_hours ( interval ) → interval``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Преобразует интервал так, что каждый 24-часовой период считается одним "
"днём"
msgstr ""
"Adjusts the interval so that each 24-hour period is counted as one day"

#: ../../general/Data_API/ecos_data.rst
msgid "``justify_hours(interval '27 hours') → 1 day 03:00:00 (1 день 03:00:00)``"
msgstr "``justify_hours(interval '27 hours') → 1 day 03:00:00``"

#: ../../general/Data_API/ecos_data.rst
msgid "``justify_interval ( interval ) → interval``"
msgstr "``justify_interval ( interval ) → interval``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Преобразует интервал с применением justify_days и justify_hours и "
"дополнительно корректирует знаки"
msgstr ""
"Adjusts the interval using justify_days and justify_hours, and "
"additionally corrects signs"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``justify_interval(interval '1 mon -1 hour') → 29 days 23:00:00 (29 дней "
"23:00:00)``"
msgstr ""
"``justify_interval(interval '1 mon -1 hour') → 29 days 23:00:00``"

#: ../../general/Data_API/ecos_data.rst
msgid "``make_date ( year int, month int, day int ) → date``"
msgstr "``make_date ( year int, month int, day int ) → date``"

#: ../../general/Data_API/ecos_data.rst
msgid "Образует дату из полей: year (год), month (месяц) и day (день)"
msgstr "Creates a date from fields: year, month, and day"

#: ../../general/Data_API/ecos_data.rst
msgid "(отрицательное значение поля year означает год до н. э.)"
msgstr "(a negative year value denotes a BC year)"

#: ../../general/Data_API/ecos_data.rst
msgid "``make_date(2013, 7, 15) → 2013-07-15``"
msgstr "``make_date(2013, 7, 15) → 2013-07-15``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``make_interval ( [years int [, months int [, weeks int [, days int [, "
"hours int [, mins int [, secs double precision]]]]]]] ) → interval``"
msgstr ""
"``make_interval ( [years int [, months int [, weeks int [, days int [, "
"hours int [, mins int [, secs double precision]]]]]]] ) → interval``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Образует интервал из полей: years (годы), months (месяцы), weeks "
"(недели), days (дни), hours (часы),"
msgstr ""
"Creates an interval from fields: years, months, weeks, days, hours,"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"minutes (минуты) и secs (секунды), каждое из которых по умолчанию "
"считается равным нулю."
msgstr ""
"minutes, and secs (seconds), each of which defaults to zero."

#: ../../general/Data_API/ecos_data.rst
msgid "``make_interval(days => 10) → 10 days``"
msgstr "``make_interval(days => 10) → 10 days``"

#: ../../general/Data_API/ecos_data.rst
msgid "``make_time ( hour int, min int, sec double precision ) → time``"
msgstr "``make_time ( hour int, min int, sec double precision ) → time``"

#: ../../general/Data_API/ecos_data.rst
msgid "Образует время из полей: hour (час), minute (минута) и sec (секунда)"
msgstr "Creates a time from fields: hour, minute, and sec (second)"

#: ../../general/Data_API/ecos_data.rst
msgid "``make_time(8, 15, 23.5) → 08:15:23.5``"
msgstr "``make_time(8, 15, 23.5) → 08:15:23.5``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``make_timestamp ( year int, month int, day int, hour int, min int, sec "
"double precision ) → timestamp``"
msgstr ""
"``make_timestamp ( year int, month int, day int, hour int, min int, sec "
"double precision ) → timestamp``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Образует момент времени из полей: year (год), month (месяц), day (день), "
"hour (час),"
msgstr ""
"Creates a timestamp from fields: year, month, day, hour,"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"minute (минута) и sec (секунда) (отрицательное значение поля year "
"означает год до н. э.)"
msgstr ""
"minute, and sec (second) (a negative year value denotes a BC year)"

#: ../../general/Data_API/ecos_data.rst
msgid "``make_timestamp(2013, 7, 15, 8, 15, 23.5) → 2013-07-15 08:15:23.5``"
msgstr "``make_timestamp(2013, 7, 15, 8, 15, 23.5) → 2013-07-15 08:15:23.5``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``make_timestamptz ( year int, month int, day int, hour int, min int, sec"
" double precision [, timezone text] ) → timestamp with time zone``"
msgstr ""
"``make_timestamptz ( year int, month int, day int, hour int, min int, sec"
" double precision [, timezone text] ) → timestamp with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"Образует дату и время с часовым поясом из полей: year (год), month "
"(месяц), day (день), hour (час), minute (минута) и sec (секунда) "
"(отрицательное значение поля year означает год до н. э.). Если параметр "
"timezone (часовой пояс) не указан, используется текущий часовой пояс; в "
"примерах предполагается часовой пояс Europe/London (Европа/Лондон)."
msgstr ""
"Creates a timestamp with time zone from fields: year, month, day, hour, "
"minute, and sec (second) (a negative year value denotes a BC year). If "
"the timezone parameter is not specified, the current time zone is used; "
"the examples assume the Europe/London time zone."

#: ../../general/Data_API/ecos_data.rst
msgid "``make_timestamptz(2013, 7, 15, 8, 15, 23.5) → 2013-07-15 08:15:23.5+01``"
msgstr "``make_timestamptz(2013, 7, 15, 8, 15, 23.5) → 2013-07-15 08:15:23.5+01``"

#: ../../general/Data_API/ecos_data.rst
msgid ""
"``make_timestamptz(2013, 7, 15, 8, 15, 23.5, 'America/New_York') → "
"2013-07-15 13:15:23.5+01``"
msgstr ""
"``make_timestamptz(2013, 7, 15, 8, 15, 23.5, 'America/New_York') → "
"2013-07-15 13:15:23.5+01``"

#: ../../general/Data_API/ecos_data.rst
msgid "``statement_timestamp ( ) → timestamp with time zone``"
msgstr "``statement_timestamp ( ) → timestamp with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "Текущая дата и время (на момент начала текущего оператора)"
msgstr "Current date and time (at the start of the current statement)"

#: ../../general/Data_API/ecos_data.rst
msgid "``statement_timestamp() → 2019-12-23 14:39:53.662522-05``"
msgstr "``statement_timestamp() → 2019-12-23 14:39:53.662522-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``timeofday ( ) → text``"
msgstr "``timeofday ( ) → text``"

#: ../../general/Data_API/ecos_data.rst
msgid "Текущая дата и время (как clock_timestamp, но в виде строки типа text)"
msgstr "Current date and time (like clock_timestamp, but returned as a text string)"

#: ../../general/Data_API/ecos_data.rst
msgid "``timeofday() → Mon Dec 23 14:39:53.662522 2019 EST``"
msgstr "``timeofday() → Mon Dec 23 14:39:53.662522 2019 EST``"

#: ../../general/Data_API/ecos_data.rst
msgid "``transaction_timestamp ( ) → timestamp with time zone``"
msgstr "``transaction_timestamp ( ) → timestamp with time zone``"

#: ../../general/Data_API/ecos_data.rst
msgid "``transaction_timestamp() → 2019-12-23 14:39:53.662522-05``"
msgstr "``transaction_timestamp() → 2019-12-23 14:39:53.662522-05``"

#: ../../general/Data_API/ecos_data.rst
msgid "``extract ( field from timestamp ) → numeric``"
msgstr "``extract ( field from timestamp ) → numeric``"

#: ../../general/Data_API/ecos_data.rst
msgid "Возвращает поле даты/времени"
msgstr "Returns a date/time field"

#: ../../general/Data_API/ecos_data.rst
msgid "``extract(hour from timestamp '2001-02-16 20:38:40') → 20``"
msgstr "``extract(hour from timestamp '2001-02-16 20:38:40') → 20``"

#: ../../general/Data_API/ecos_data.rst
msgid "``extract ( field from interval ) → numeric``"
msgstr "``extract ( field from interval ) → numeric``"

#: ../../general/Data_API/ecos_data.rst
msgid "Возвращает поле интервала"
msgstr "Returns an interval field"

#: ../../general/Data_API/ecos_data.rst
msgid "``extract(month from interval '2 years 3 months') → 3``"
msgstr "``extract(month from interval '2 years 3 months') → 3``"

#: ../../general/Data_API/ecos_data.rst
msgid "``localtime → time``"
msgstr "``localtime → time``"

#: ../../general/Data_API/ecos_data.rst
msgid "``localtime → 14:39:53.662522``"
msgstr "``localtime → 14:39:53.662522``"

#: ../../general/Data_API/ecos_data.rst
msgid "``localtime ( integer ) → time``"
msgstr "``localtime ( integer ) → time``"

