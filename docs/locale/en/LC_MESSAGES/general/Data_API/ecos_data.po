#: ../../general/Data_API/ecos_data.rst
msgid "Выбирает наибольшее значение из списка выражений."
msgstr "Selects the largest value from a list of expressions."

#: ../../general/Data_API/ecos_data.rst
msgid "``LEAST(значение [, ...])``"
msgstr "``LEAST(value [, ...])``"

#: ../../general/Data_API/ecos_data.rst
