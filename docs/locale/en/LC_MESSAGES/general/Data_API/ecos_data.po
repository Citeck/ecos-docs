msgstr ""
"Available for all numeric and string types, enumeration types, and "
"date/time types."

#: ../../general/Data_API/ecos_data.rst
msgid "``min ( см. описание ) → тот же тип, что на входе``"
msgstr "``min ( see description ) → same type as input``"

#: ../../general/Data_API/ecos_data.rst
msgid "Вычисляет минимальное из всех значений, отличных от NULL."
msgstr "Computes the minimum of all non-NULL input values."

#: ../../general/Data_API/ecos_data.rst
msgid "``sum ( number ) → bigint``"
msgstr "``sum ( number ) → bigint``"

#: ../../general/Data_API/ecos_data.rst
msgid "Вычисляет сумму всех входных значений, отличных от NULL."
msgstr "Computes the sum of all non-NULL input values."

