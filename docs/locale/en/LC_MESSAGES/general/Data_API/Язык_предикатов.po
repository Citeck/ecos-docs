#: ../../general/Data_API/Язык_предикатов.rst:146
msgid "``contains``"
msgstr "``contains``"

#: ../../general/Data_API/Язык_предикатов.rst:147
msgid "Для строки — наличие подстроки, для массива — наличие равного элемента"
msgstr "For strings, substring presence; for arrays, presence of an equal element"

