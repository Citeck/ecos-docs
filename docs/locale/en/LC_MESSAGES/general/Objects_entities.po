#~ " хранящиеся в форматах JSON/YAML/XML и "
#~ "разворачиваемые в систему через интерфейс "
#~ "или средства автоматизации."
#~ msgstr ""
#~ "Configuration objects of the platform "
#~ "(data types, forms, journals, processes, "
#~ "etc.) stored in JSON/YAML/XML formats "
#~ "and deployed to the system via the"
#~ " interface or automation tools."

#~ msgid ""
#~ "Разовые операции миграции данных и "
#~ "конфигурации, выполняемые автоматически или "
#~ "вручную при запуске системы. Реализованы "
#~ "как артефакты типа ``app/patch``."
#~ msgstr ""
#~ "One-time data and configuration "
#~ "migration operations executed automatically or"
#~ " manually on system startup. Implemented"
#~ " as artifacts of type ``app/patch``."

#~ msgid ""
