msgid "**anthropic** - Claude модели (claude-opus-4-5 и др.)"
msgstr "**anthropic** - Claude models (claude-opus-4-5, etc.)"

#: ../../general/AI_Assistant_config.rst:158
msgid "**deepseek** - модели DeepSeek (deepseek-chat, deepseek-coder)"
msgstr "**deepseek** - DeepSeek models (deepseek-chat, deepseek-coder)"

