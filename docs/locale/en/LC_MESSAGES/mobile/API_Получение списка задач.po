#: ../../mobile/API_Получение задач.rst:2 списка
msgid "Получение списка задач"
msgstr "Getting Task List"

#: ../../mobile/API_Получение задач.rst:4 списка
msgid "выполнить запрос ``/gateway/api/records/query``"
msgstr "execute request ``/gateway/api/records/query``"

#: ../../mobile/API_Получение задач.rst:50 списка

msgid "Для получения списка завершённых задач укажите атрибут ``active: false``."
msgstr "To get the list of Completed tasks, change the attribute ``active: false``"

#: ../../mobile/API_Получение задач.rst:52 списка
msgid "отфильтровать записи по ранее полученным"
msgstr "filter records by previously obtained ones"

#: ../../mobile/API_Получение задач.rst:53 списка
msgid ""
"перебрать все элементы ``resp.records``, получить ключи форм "
"``attributes.formKey``"
msgstr ""
"iterate through all ``resp.records`` elements, get form keys "
"``attributes.formKey``"

#: ../../mobile/API_Получение задач.rst:54 списка
msgid "выполнить запрос ``/gateway/api/records/query``, получить настройки форм"
msgstr "execute request ``/gateway/api/records/query``, get form settings"

#: ../../mobile/API_Получение задач.rst:72 списка
msgid "полученные формы передать в функцию ``parseForm``"
msgstr "pass the obtained forms to the ``parseForm`` function"

#: ../../mobile/API_Получение задач.rst:73 списка
msgid "получить данные для всех форм ``/gateway/api/records/query``"
msgstr "get data for all forms ``/gateway/api/records/query``"

#: ../../mobile/API_Получение задач.rst:82 списка
msgid "сопоставить задачи, полученные на первом шаге, и данные для форм"
msgstr "match tasks obtained in the first step with data for forms"

